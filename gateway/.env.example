# ── Atlas Gateway configuration ────────────────────────────────────────────
# Copy to `.env` and fill in the providers you actually have a subscription for.
# You only need the key(s) for the model(s) you plan to use in the app.

# ── Network ────────────────────────────────────────────────────────────────
# Port the gateway listens on.
PORT=8765
# Host interface. 0.0.0.0 exposes it to your LAN.
HOST=0.0.0.0

# Public wss:// URL the iOS app connects to. The app ONLY accepts wss:// (TLS).
# Leave BLANK to use the built-in tunnel (recommended — pairing works with just
# `npm start`). Set this only if you want a stable custom address.
#   e.g. PUBLIC_URL=wss://atlas.yourdomain.com
PUBLIC_URL=

# Bundled tunnel. "auto" (default) starts a Cloudflare quick tunnel when no
# PUBLIC_URL/TLS is set, so `npm start` gives a scannable wss:// QR with no
# setup. Set to "off" to disable (e.g. if you manage your own tunnel/TLS).
TUNNEL=auto

# Optional direct TLS (so the gateway serves wss:// itself instead of via a tunnel).
# Provide paths to a certificate and private key trusted by iOS.
TLS_CERT=
TLS_KEY=

# Friendly name shown in the app for this gateway.
GATEWAY_NAME=My Atlas Gateway

# ── Providers (bring your own key — only fill in what you use) ──────────────
# OpenAI  (app model: "GPT")
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Anthropic  (app model: "Claude")
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Google Gemini  (app model: "Gemini")
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_MODEL=gemini-1.5-pro

# Local model via an OpenAI-compatible endpoint such as Ollama or LM Studio
# (app model: "Local Model"). Leave BASE_URL empty to disable.
LOCAL_BASE_URL=
LOCAL_MODEL=llama3.1
LOCAL_API_KEY=ollama

# ── Behaviour ──────────────────────────────────────────────────────────────
# System prompt prepended to every conversation.
SYSTEM_PROMPT=You are Atlas, a helpful, concise personal AI agent.

# Allow the read_file tool to actually read from disk (still requires in-app approval).
ENABLE_FILE_TOOL=true
# Allow the run_command tool to execute shell commands (HIGH risk, approval-gated).
ENABLE_SHELL_TOOL=false

# ── Web search (optional) ──────────────────────────────────────────────────
# The web_search tool is enabled automatically when a key below is present.
# Provider is auto-detected (Tavily preferred); override with SEARCH_PROVIDER.
#   Tavily  — https://tavily.com        (free tier, agent-optimized, gives an answer)
#   Brave   — https://brave.com/search/api  (free tier)
TAVILY_API_KEY=
BRAVE_API_KEY=
# SEARCH_PROVIDER=tavily   # force a provider: tavily | brave | none
SEARCH_MAX_RESULTS=5

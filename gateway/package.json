{
  "name": "atlas-gateway",
  "version": "1.0.0",
  "description": "Self-hosted gateway server for the Atlas iOS agent. Routes to OpenAI, Anthropic, or Google using your own API keys.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "atlas-gateway": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "serve": "node dist/index.js",
    "pair": "tsx src/index.ts --show-pairing",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^1.2.0",
    "@ai-sdk/google": "^1.2.0",
    "@ai-sdk/openai": "^1.3.0",
    "ai": "^4.3.0",
    "cloudflared": "^0.7.0",
    "dotenv": "^16.4.7",
    "node-cron": "^3.0.3",
    "qrcode": "^1.5.4",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/node-cron": "^3.0.11",
    "@types/qrcode": "^1.5.5",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
